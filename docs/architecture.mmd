%% Architecture of support-triage-agent at commit b829fee07826709829efe992fcb4f1f4e11b0a74
%% Sources: demo.py, agent.py, llm.py, models.py, state.py, tools.py, simulation.py, streamlit_app.py, tests/test_agent.py, tests/test_simulation.py, tests/test_streamlit_app.py
%% Render: npx @mermaid-js/mermaid-cli -i docs/architecture.mmd -o docs/images/architecture.svg -b white
flowchart LR
    DEMO["python demo.py<br/>3 synthetic scenarios,<br/>scripted customer replies"]
    TESTS["pytest: 66 offline tests<br/>mock adapter, AppTest"]
    TRAINEE(["Human trainee"])

    LOOP["agent.py bounded loop<br/>ID + evidence guards,<br/>max 8 steps"]
    APP["streamlit_app.py +<br/>simulation.py: choices,<br/>scripted customer, score"]

    OUT["Ask customer, resolve<br/>or typed escalation"]
    MOCK["MockDecisionAdapter<br/>rule-based, default"]
    OAI["OpenAI decision adapter<br/>optional, needs key"]
    STATE[("CaseState + audit trail<br/>in memory")]
    TOOLS["tools.py allow-listed tools<br/>over synthetic fixtures"]
    LIVE["Live AI customer<br/>OpenAI, optional"]

    DEMO -->|"issue, follow-ups"| LOOP
    TESTS -.-> LOOP
    TESTS -.-> APP
    TRAINEE -->|"choice or free text"| APP

    LOOP --> OUT
    LOOP <-->|"state / decision"| MOCK
    LOOP <-.->|"state / decision"| OAI
    LOOP <-->|"evidence"| STATE
    LOOP -->|"validated call"| TOOLS
    APP -->|"diagnostic call"| TOOLS
    APP <-.->|"message / reply"| LIVE

    class DEMO,TOOLS,MOCK mock
    class LOOP,OUT,APP det
    class OAI,LIVE ai
    class STATE store
    class TRAINEE human
    class TESTS eval

    classDef ai fill:#efe7fb,stroke:#6a4c93,stroke-width:2px,color:#2b1d45;
    classDef det fill:#eef3f8,stroke:#2f5d8a,stroke-width:1.5px,color:#172c37;
    classDef human fill:#e8f0ec,stroke:#285b48,stroke-width:1.5px,color:#173f32;
    classDef eval fill:#f7efdf,stroke:#8b6330,stroke-width:1.5px,color:#4a3413;
    classDef store fill:#f3f4f1,stroke:#65757b,stroke-width:1.5px,color:#172c37;
    classDef ext fill:#ffffff,stroke:#2f5d8a,stroke-width:1.5px,stroke-dasharray:4 3,color:#172c37;
    classDef mock fill:#ffffff,stroke:#9aa5a8,stroke-width:1.5px,stroke-dasharray:6 4,color:#65757b;
